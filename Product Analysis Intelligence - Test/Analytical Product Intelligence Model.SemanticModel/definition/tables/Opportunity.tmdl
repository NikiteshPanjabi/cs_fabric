	column Win/Lost
		dataType: string
		lineageTag: 4a2f14f4-18dc-4607-bb71-56c1806114d9
		summarizeBy: none
		sourceColumn: Win/Lost

		annotation SummarizationSetBy = Automatic

	partition Opportunity = m
		mode: import
		source = ```
				let
				    Source = PowerPlatform.Dataflows(null),
				    Workspaces = Source{[Id="Workspaces"]}[Data],
				    #"05b8b535-6823-453f-890a-08ddf6ae067d" = Workspaces{[workspaceId="05b8b535-6823-453f-890a-08ddf6ae067d"]}[Data],
				    #"8e39386f-8f3f-455f-9256-ef71d52c595a" = #"05b8b535-6823-453f-890a-08ddf6ae067d"{[dataflowId="8e39386f-8f3f-455f-9256-ef71d52c595a"]}[Data],
				    Opportunity_ = #"8e39386f-8f3f-455f-9256-ef71d52c595a"{[entity="Opportunity",version=""]}[Data],
				    #"Merged Queries" = Table.NestedJoin(Opportunity_, {"Opportunity ID"}, #"Opportunity Stage Changes", {"Opportunity ID"}, "Opportunity Stage Changes", JoinKind.LeftOuter),
				    #"Expanded Opportunity Stage Changes" = Table.ExpandTableColumn(#"Merged Queries", "Opportunity Stage Changes", {"Old Value (Renamed)"}, {"Previous Stage"}),
				    #"Close Date (Calculated)" = Table.TransformColumnTypes(Table.AddColumn(#"Expanded Opportunity Stage Changes", "Close Date (Calculated)", 
				    each if [Forecast Category] = "Won" then [Close Date] 
				    else if ([Forecast Category] <> "Won" and [Forecast Category] <> "Omit") then [Close Date] 
				    else [#"Last Stage Change Date"]), {{"Close Date (Calculated)", type date}}),
				    #"Add Win Loss Column" = Table.AddColumn(#"Close Date (Calculated)", "Win/Lost", each 
				        if [Opportunity Type] = "New Name Account" and [Forecast Category] = "Won" then "Won"
				        else if [Opportunity Type] = "New Name Account" and 
				                ([Stage] = "Business Lost" or [Stage] = "Lost") and 
				                ([Previous Stage] = "SMO" or [Previous Stage] = "SQL") and 
				                [Forecast Category] = "Omit" then "Lost"
				        else null
				    )
				in
				    #"Add Win Loss Column"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

